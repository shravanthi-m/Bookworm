# Copy to .env (git-ignored) and fill in from app.viam.com:
#   your machine -> CONNECT tab -> "API keys" (or Code sample -> Python, "Include API key")
VIAM_ADDRESS=your-machine-main.xxxxxxxx.viam.cloud
VIAM_API_KEY_ID=
VIAM_API_KEY=

# Summaries + vision checks: openrouter.ai -> Keys (set a credit limit on the key)
OPENROUTER_API_KEY=

# Natural voice (optional): elevenlabs.io -> Profile -> API keys. Without it the Mac voice is used.
ELEVENLABS_API_KEY=
